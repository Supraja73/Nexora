# NEXORA Environment Configuration

# Server
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./nexora.db

# Docker Configuration
# WARNING: When enabled, offline mode uses synthetic demo containers/metrics, not real Linux telemetry.
# Confirm /api/docker/status reports mode=live before presenting metrics as real.
# For Windows Docker Desktop, usually left empty for auto-detect or npipe:////./pipe/docker_engine
# For Linux/WSL2, usually unix:///var/run/docker.sock
DOCKER_HOST=
DOCKER_TIMEOUT=15

# Security
ALLOWED_IMAGES=alpine:latest,alpine:3.19,nginx:alpine,python:3.12-alpine,redis:alpine,busybox:latest,ubuntu:latest,node:20-alpine
MAX_CONTAINER_MEMORY_MB=4096
MAX_CONTAINER_CPUS=4.0
ENABLE_DEMO_FALLBACK=True

# Monitoring
MONITORING_INTERVAL_SECONDS=2
METRICS_HISTORY_RETENTION_HOURS=24
